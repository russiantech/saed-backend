# Used by docker-compose.yml (cp deploy/.env.example deploy/.env). Production values - never commit the real file.
POSTGRES_PASSWORD=change-me
DJANGO_SECRET_KEY=generate-with:  python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_ALLOWED_HOSTS=saed-api.example.com
# The web app (separate repo/host). Same SITE as the API (app.example.com + api.example.com) is strongly recommended.
FRONTEND_URL=https://saed.example.com
BACKEND_URL=https://saed-api.example.com
CORS_ALLOWED_ORIGINS=https://saed.example.com
CSRF_TRUSTED_ORIGINS=https://saed.example.com
# Only when the app and the API are on DIFFERENT sites (HTTPS required). See docs/DEPLOYMENT.md.
# CROSS_SITE_COOKIES=1
PAYSTACK_SECRET_KEY=sk_live_xxx
PAYSTACK_PUBLIC_KEY=pk_live_xxx
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=NYSC SAED IMS <noreply@example.com>
# public = anyone can read the API docs; staff = signed-in admins only (404 for everyone else); off
API_DOCS=staff
