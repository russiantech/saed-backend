# ── Core ─────────────────────────────────────────────────────────────────────
# Local development: set DJANGO_DEBUG=1 (a SECRET_KEY is then optional).
# Production: DJANGO_DEBUG must be 0 and DJANGO_SECRET_KEY / DJANGO_ALLOWED_HOSTS are REQUIRED.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_URL=admin/

# ── Database (one setting, two backends) ─────────────────────────────────────
# SQLite (default if unset):   DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL:                  DATABASE_URL=postgres://saed:password@localhost:5432/saed
DATABASE_URL=sqlite:///db.sqlite3
DB_CONN_MAX_AGE=60

# ── URLs / CORS / CSRF ───────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3002
BACKEND_URL=http://127.0.0.1:8002
CORS_ALLOWED_ORIGINS=http://localhost:3002
CSRF_TRUSTED_ORIGINS=http://localhost:3002

# ── Production transport security (defaults to ON when DJANGO_DEBUG=0) ───────
# SECURE_SSL_REDIRECT=1
# USE_X_FORWARDED_PROTO=1        # set when behind a TLS-terminating proxy
# SECURE_HSTS_SECONDS=31536000
# TRUSTED_PROXY_COUNT=1          # number of proxies in front (for per-IP throttling)

# ── Cache / throttling ───────────────────────────────────────────────────────
# Without REDIS_URL throttle counters are per-process; set Redis for multi-worker deployments.
# REDIS_URL=redis://localhost:6379/1
AUTH_THROTTLE_RATE=30/min

# ── Media ────────────────────────────────────────────────────────────────────
# MEDIA_ROOT=./media                    # public (profile pictures only)
# PRIVATE_MEDIA_ROOT=./protected_media  # lesson videos/documents – NEVER expose via web server
SAED_MAX_VIDEO_BYTES=524288000
SAED_MAX_DOCUMENT_BYTES=104857600

# ── Paystack ─────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx

# ── Email ────────────────────────────────────────────────────────────────────
# Console backend is used automatically in DEBUG. For production:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=NYSC SAED IMS <noreply@saed-ims.ng>

# ── API documentation (/api/docs/, /api/redoc/, /api/openapi.json, /docs/) ───
# public = anyone (default in DEBUG) | staff = signed-in admins/staff (default in production) | off
API_DOCS=public
LOG_LEVEL=INFO
