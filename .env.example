# Django Configuration
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# SSL / Cookies (Set to True in production with HTTPS)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=False
CSRF_COOKIE_SAMESITE=Lax

# Database
# Option 1 (Recommended for production): DATABASE_URL
# DATABASE_URL=postgres://user:password@host:5432/dbname
# Option 2: Individual variables
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=saed_db
# DATABASE_USER=postgres
# DATABASE_PASSWORD=secret
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# Option 3 (Default local dev fallback): SQLite
# SQLITE_NAME=db.sqlite3

# CORS & CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,https://yourdomain.com
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3002,https://yourdomain.com

# Email (SMTP Configuration)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com
MD_EMAIL=admin-notify@yourdomain.com

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Paystack Gateway
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_API_URL=https://api.paystack.co
PAYSTACK_DEFAULT_AMOUNT=50000

# Administrative Secrets
ADMIN_SIGNUP_SECRET=replace-with-admin-signup-secret

# Cloud Object Storage (Choose S3 or Cloudinary, optional for production)
# USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=

# USE_CLOUDINARY=False
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Sentry Monitoring (optional)
# SENTRY_DSN=https://xxx@sentry.io/xxx
# SENTRY_TRACES_SAMPLE_RATE=0.2
# ENVIRONMENT=production
